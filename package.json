    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.0.0",
    "next": "15.5.29",
    "openai": "7.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "svix": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
